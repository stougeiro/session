{
    "name": "stougeiro/session",
    "description": "A secure, predictable and extensible session manager for PHP‑FPM applications, featuring custom lifecycle, automatic expiration, safe ID regeneration and pluggable storage handlers (file and SQLite).",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "session",
        "php session",
        "session manager",
        "session handler",
        "session lifecycle",
        "session regeneration",
        "session expiration",
        "session security",
        "php-fpm",
        "sqlite session",
        "file session",
        "session storage",
        "session cookie",
        "session destroy",
        "session start",
        "middleware"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/session/issues",
        "source": "https://github.com/stougeiro/session"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Session\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "stougeiro/session-contract": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
